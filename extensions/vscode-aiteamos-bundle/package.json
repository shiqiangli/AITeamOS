{
  "name": "aiteamos-bundle-reference",
  "displayName": "AITEAMOS Bundle Reference",
  "description": "Reference VSCode/Cursor extension for importing aiteamos-bundle.json v1 and posting assisted ingest.",
  "version": "0.1.0",
  "publisher": "aiteamos",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiteamosBundle.import",
    "onCommand:aiteamosBundle.writeIngest"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiteamosBundle.import",
        "title": "AITEAMOS Bundle: Import aiteamos-bundle.json"
      },
      {
        "command": "aiteamosBundle.writeIngest",
        "title": "AITEAMOS Bundle: Submit Assisted Ingest"
      }
    ]
  }
}
